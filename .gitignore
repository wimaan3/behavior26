# Data — never commit. LeRobot demo set is 3.27 TB, raw HDF5 is 1.44 TB.
data/
*.hdf5
*.parquet
# ...but the derived progress-label sidecars are small (14 MB for 3 tasks) and are
# how the cloud box gets its labels with the clone. Checked in deliberately.
!labels/**/*.parquet
*.mp4
*.usd

# Checkpoints & training output
checkpoints/
outputs/
*.ckpt
*.safetensors
norm_stats.json

# Rollout artifacts
rollouts/
videos/
*.log

# Secrets — W&B keys, HF tokens, cloud creds
.env
.env.*
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# The openpi fork. Cloned as a SIBLING directory, never inside this repo -- it is
# ~1GB and has its own git history. Our changes to it live in training/patches/
# and are applied with scripts/apply_openpi_patches.sh.
openpi/
../openpi/

# Built submission packages -- regenerate with submission.build
submission/dist/

# docs/ is the project's RECORD and nothing under it is ignored. The *.log and
# norm_stats.json rules above are for scratch output; without this they silently
# kept every training log behind the rung 1-5 results off GitHub.
# (tests/test_evidence_is_tracked.py)
!docs/**
