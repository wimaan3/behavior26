# Normalize line endings on commit. Without this, a checkout on a machine with
# core.autocrlf=true rewrites every line of the generated census/reward tables and
# the next diff is the whole file.
* text=auto eol=lf

# Generated analysis artifacts: always LF in the index AND in the working tree,
# regardless of platform or local autocrlf setting. These are regenerated by
# scripts, diffed across runs, and must stay byte-comparable.
analysis/census/*.csv    text eol=lf
analysis/census/*.json   text eol=lf
analysis/reward/*.csv    text eol=lf
analysis/reward/*.json   text eol=lf

# Never touched by EOL conversion.
*.png    binary
*.mp4    binary
*.usd    binary
*.hdf5   binary
*.parquet binary
