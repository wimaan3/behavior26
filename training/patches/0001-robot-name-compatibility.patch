 from .base_config import ObservationConfig, StateActionConfig, RobotConfig, register_robot
 
 
+# ------------------------------------------------------------------ behavior26
+# The robot's name in the OmniGibson scene. It MUST equal the `name:` field of
+# the robot config the evaluator is launched with (`--robot-config`), because
+# every observation key is prefixed with it:
+#
+#   omnigibson/eval/r1pro.yaml (v3.9.2)   name: robot_r1
+#   this file, upstream                   name="robot"
+#
+# openpi's own serving wrapper looks up
+#
+#   openpi/shared/eval_b1k_wrapper.py:72
+#       prop_state = obs[f"{self.robot.name}::proprio"]
+#
+# so with the upstream "robot" it asks for `robot::proprio` while the evaluator
+# publishes `robot_r1::proprio`, and the first step of the first rollout dies
+# with a KeyError. Same for all three cameras (l.79). This is an upstream bug:
+# the two files ship inconsistent names and nothing checks them.
+#
+# We align to the EVALUATOR's name rather than editing the robot config, so the
+# .yaml we submit stays byte-identical to the organizers' own file -- it is an
+# inspected submission artifact, and it still works if they substitute theirs.
+#
+# behavior26 pins this with tests/test_robot_config.py, which reads both files
+# and fails if they diverge again.
+ROBOT_NAME = "robot_r1"
+
+
+def _rgb_obs_key(link: str, robot_name: str = ROBOT_NAME) -> str:
+    """Observation-dict key for a camera, as OmniGibson publishes it.
+
+    Format is `{robot}::{robot}:{link}:Camera:0::rgb`. Derived rather than
+    written out three times, so changing ROBOT_NAME cannot leave a stale literal
+    behind -- which is how the mismatch above survived in the first place.
+    """
+    return f"{robot_name}::{robot_name}:{link}:Camera:0::rgb"
+
+
